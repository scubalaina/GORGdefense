# Get defense subtypes in <= 1% of SAGs
subset_1p_subtype = function(meltsubtype,totalsags){
  count_df = meltsubtype %>%
    group_by(subtype) %>%
    summarise(sags = n()) %>%
    arrange(desc(sags)) 
  count_df$prop_total = count_df$sags/totalsags
  subbed_df = subset(count_df,count_df$prop_total >= 0.01)
  top_defs = as.vector(subbed_df$subtype)
  return(top_defs)
}

