# Determine the taxonomic orders containing at least 1% of SAGs 
subset_1p_ord = function(wide){
  count_df = wide %>%
    group_by(Order) %>%
    summarise(sags = n()) %>% mutate(prop_sags = sags / sum(sags)) %>%
    arrange(desc(sags)) 
  subbed_df = subset(count_df,count_df$prop_sags >= 0.01)
  top_orders = as.vector(subbed_df$Order)
  return(top_orders)
}

